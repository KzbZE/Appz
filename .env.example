# =====================================================
# Variables d'Environnement TheraFlow
# =====================================================
# Copiez ce fichier en .env et remplissez vos vraies valeurs

# =====================================================
# MODE D'AUTHENTIFICATION
# =====================================================
# true = Mode local (IndexedDB) - Pour développement sans Supabase
# false = Mode Supabase Cloud - Pour production
VITE_FORCE_LOCAL_AUTH=false

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
# Pour obtenir ces valeurs:
# 1. https://supabase.com → Votre projet → Settings → API
# 2. Copiez "Project URL" et "anon public" key
# ⚠️ Utilisez "anon public", PAS "service_role"

VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.votre_vraie_clé_ici

# =====================================================
# GOOGLE API KEYS (Optionnel)
# =====================================================

# Gemini AI (pour fonctionnalités IA - optionnel)
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Google Places API (pour auto-complétion d'adresses)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API
VITE_GOOGLE_PLACES_API_KEY=

# =====================================================
# GUIDES DE CONFIGURATION
# =====================================================
# Quick Start (10 min): QUICK-START-SUPABASE.md
# Guide complet: GUIDE-CONFIGURATION-SUPABASE.md
